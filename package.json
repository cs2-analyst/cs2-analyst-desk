{
  "name": "cs2-analyst",
  "private": true,
  "version": "0.2.0",
  "packageManager": "pnpm@10.0.0",
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild"]
  },
  "scripts": {
    "parser:build-fixed": "pnpm --filter @cs2-analyst/demoparser-native build:native",
    "parser:verify": "pnpm --filter @cs2-analyst/demoparser-native verify",
    "dev": "turbo run dev",
    "start": "turbo run start",
    "typecheck": "turbo run typecheck",
    "test:smoke": "turbo run test:smoke",
    "test:installed": "turbo run test:installed",
    "build": "turbo run build"
  },
  "devDependencies": {
    "turbo": "^2.11.6"
  }
}
