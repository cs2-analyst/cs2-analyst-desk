{
  "name": "@cs2-analyst/dem-parser",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" },
    "./local-evidence": { "types": "./dist/local-evidence.d.ts", "import": "./dist/local-evidence.js" }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm --filter @cs2-analyst/match-model build && pnpm build && tsc -p tests/tsconfig.json && node --test tests/*.test.mjs"
  },
  "dependencies": {
    "@cs2-analyst/match-model": "workspace:^",
    "@cs2-analyst/demoparser-native": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^24.19.0",
    "typescript": "^7.0.2"
  }
}
